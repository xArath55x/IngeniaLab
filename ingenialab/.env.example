# Referencia: Django lee variables del sistema; no carga este archivo automáticamente.
INGENIALAB_MODULES=interviews,classification,modeling
INGENIALAB_AI_MODE=catalog
# Para activar IA: modo chat_completions y endpoint/modelo que tengas disponibles.
# INGENIALAB_AI_ENDPOINT=http://127.0.0.1:8001/v1/chat/completions
# INGENIALAB_AI_MODEL=nombre-del-modelo
# INGENIALAB_AI_API_KEY=
INGENIALAB_AI_TIMEOUT=1.2
# Respuesta libre del cliente (requiere chat_completions). Ollama local: endpoint
# http://127.0.0.1:11434/v1/chat/completions y modelo qwen2.5:7b.
INGENIALAB_AI_FREE_ANSWERS=0
INGENIALAB_AI_FREE_TIMEOUT=8
